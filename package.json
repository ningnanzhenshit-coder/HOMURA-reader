{
  "name": "homura-reader",
  "version": "2.1.4",
  "private": true,
  "description": "HOMURA — ACGN GO 本地漫画与轻小说阅读器",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "tauri": "tauri",
    "icons:generate": "node scripts/generate-icons.mjs",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "dev": "tauri dev",
    "build": "tauri build",
    "android:sync-icons": "node scripts/sync-android-icons.mjs",
    "android:init": "tauri android init && npm run android:sync-icons",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --target aarch64 --apk",
    "android:build:debug": "tauri android build --debug --target aarch64 --apk"
  },
  "dependencies": {
    "@tauri-apps/plugin-fs": "^2.7.1",
    "jszip": "^3.10.1",
    "marked": "^18.1.2",
    "pdfjs-dist": "^6.4.299",
    "pinia": "^3.0.3",
    "pinyin-pro": "^3.29.5",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.3.5"
  }
}
