{
  "identifier": "default",
  "description": "HOMURA 主窗口默认权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:allow-exit",
    "android-toast:default",
    "android-predictive-back:default",
    "android-installer:default",
    "android-archive:default",
    "android-system-bars:default",
    "fs:default",
    "fs:allow-appcache-read-recursive",
    "fs:allow-appdata-meta-recursive",
    "fs:allow-appdata-write-recursive",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/ningnanzhenshit-coder/HOMURA-reader"
        },
        {
          "url": "https://github.com/ningnanzhenshit-coder/HOMURA-reader/*"
        }
      ]
    },
    "core:window:allow-set-theme",
    "core:window:allow-set-background-color",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-focus",
    "core:webview:allow-set-webview-background-color"
  ]
}
